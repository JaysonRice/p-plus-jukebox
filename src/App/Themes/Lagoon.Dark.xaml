<!-- Lagoon colors, dark (generated from the palette page; see PLAN.md). ThemeService copies these into Application.Resources,
     so they override the Fluent theme's accent colors. Brushes use literal colors on purpose: they are copied, not referenced. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#4ABF85</Color>
    <Color x:Key="AccentColorDark3">#1D5338</Color>
    <Color x:Key="AccentColorDark2">#28714D</Color>
    <Color x:Key="AccentColorDark1">#338F61</Color>
    <Color x:Key="AccentColorLight1">#3DAD76</Color>
    <Color x:Key="AccentColorLight2">#4ABF85</Color>
    <Color x:Key="AccentColorLight3">#68CA99</Color>
    <Color x:Key="SystemAccentColor">#4ABF85</Color>
    <Color x:Key="SystemAccentColorDark3">#1D5338</Color>
    <Color x:Key="SystemAccentColorDark2">#28714D</Color>
    <Color x:Key="SystemAccentColorDark1">#338F61</Color>
    <Color x:Key="SystemAccentColorLight1">#3DAD76</Color>
    <Color x:Key="SystemAccentColorLight2">#4ABF85</Color>
    <Color x:Key="SystemAccentColorLight3">#68CA99</Color>
    <Color x:Key="ApplicationBackgroundColor">#141A17</Color>
    <SolidColorBrush x:Key="LagoonAccentBrush" Color="#4ABF85" />
    <SolidColorBrush x:Key="LagoonOnAccentBrush" Color="#0C1D14" />
    <SolidColorBrush x:Key="LagoonPlaybackBrush" Color="#51D6D6" />
    <SolidColorBrush x:Key="LagoonAttentionBrush" Color="#4094E7" />
    <SolidColorBrush x:Key="LagoonEndBrush" Color="#EF7B66" />
    <SolidColorBrush x:Key="LagoonEmptyBrush" Color="#2E3833" />
    <SolidColorBrush x:Key="LagoonMutedBrush" Color="#8B9C94" />
    <SolidColorBrush x:Key="LagoonRuleBrush" Color="#37433D" />
    <SolidColorBrush x:Key="LagoonSurfaceBrush" Color="#1F2824" />
    <SolidColorBrush x:Key="LagoonInkBrush" Color="#E8EDEB" />
    <SolidColorBrush x:Key="LagoonOnPlaybackBrush" Color="#0D1311" />
    <SolidColorBrush x:Key="LagoonOnAttentionBrush" Color="#0D1311" />
    <SolidColorBrush x:Key="LagoonOnEndBrush" Color="#0D1311" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#141A17" />
    <SolidColorBrush x:Key="LagoonWindowBrush" Color="#141A17" />
</ResourceDictionary>
