<UserControl x:Class="PPlusTracklistEditor.App.Views.LoopMakerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:PPlusTracklistEditor.App.Views"
             xmlns:vm="clr-namespace:PPlusTracklistEditor.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:LoopMakerViewModel}"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Background="Transparent">
    <Grid>
        <!-- Nothing open: pick or drop a file -->
        <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" BorderThickness="2" CornerRadius="8"
                BorderBrush="#50808080" Margin="40" Padding="32">
            <Border.Resources>
                <Style TargetType="Border" />
            </Border.Resources>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                <TextBlock Text="Make a looping song" Style="{StaticResource Heading}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,0,0,20"
                           Text="Turn an MP3, WAV, FLAC or M4A into a song Project+ can play, and choose where it loops. You can also open a BRSTM to change its loop. The song is saved to your library; add it to stages from the Stages tab." />
                <Button Content="Choose an audio file…" Command="{Binding ChooseFileCommand}" HorizontalAlignment="Center"
                        Padding="20,8" FontWeight="SemiBold" />
                <TextBlock Text="or drag a file here" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- Just saved -->
        <StackPanel Visibility="{Binding IsSaved, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <TextBlock Text="✓ Saved to your library" Style="{StaticResource Heading}" HorizontalAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Text="{Binding SavedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Make another song…" Command="{Binding ChooseFileCommand}" Padding="16,6" FontWeight="SemiBold" Margin="0,0,8,0" />
                <Button Content="Go to the Song Library" Command="{Binding ShowInLibraryCommand}" Padding="16,6" />
            </StackPanel>
        </StackPanel>

        <!-- Editing -->
        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" Margin="12,12,12,8">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Start over" Command="{Binding StartOverCommand}" Padding="16,4" Margin="0,0,8,0"
                        ToolTip="Close this song without saving it" />
                <Button Content="Save to library" Command="{Binding SaveToLibraryCommand}" Padding="24,4" FontWeight="SemiBold"
                        IsEnabled="{Binding Editor.IsReady}" />
            </StackPanel>
            <views:LoopEditorView DataContext="{Binding Editor}" />
        </DockPanel>
    </Grid>
</UserControl>
