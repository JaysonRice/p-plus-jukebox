<Window x:Class="PPlusTracklistEditor.App.Views.AddSongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a song" Width="500" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="FileText" Style="{StaticResource Hint}" Margin="0,0,0,12" />
        <TextBlock Text="Title (shown in the game's song menu)" Margin="0,0,0,4" />
        <TextBox x:Name="TitleBox" Padding="6,4" Margin="0,0,0,12" />
        <TextBlock Text="Series (optional: the folder it's kept in, like &quot;Kirby&quot;. Leave empty if it isn't from a series.)" TextWrapping="Wrap" Margin="0,0,0,4" />
        <ComboBox x:Name="SeriesBox" IsEditable="True" Margin="0,0,0,16" />
        <DockPanel>
            <Button x:Name="PlayButton" DockPanel.Dock="Left" Content="Play / Stop" Click="Play_Click" Padding="12,4" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Skip" IsCancel="True" Padding="16,4" Margin="0,0,8,0" />
                <Button Content="Add" IsDefault="True" Click="Add_Click" Padding="24,4" FontWeight="SemiBold" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
