<UserControl x:Class="PPlusTracklistEditor.App.Views.StageListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Stage Lists tab: the build's 8 presets on the left, the chosen one's stages on the right. DataContext: StageListsViewModel. -->
    <Grid>
        <TextBlock Text="This build has no stage lists. They come from your Project+ folder (pf\stage\switch)." Style="{StaticResource Hint}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"
                   Visibility="{Binding HasPresets, Converter={StaticResource InverseBoolToVis}}" />

        <Grid Visibility="{Binding HasPresets, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: the presets, in the order L/R cycles them on Random -->
            <DockPanel Margin="12,12,6,12">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="2,0,0,8"
                           Text="In the game, press L or R on Random to switch between these." />
                <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" AutomationProperties.Name="Stage list presets">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Right: the chosen preset -->
            <DockPanel Grid.Column="1" Margin="6,12,12,12">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="Discard changes" Command="{Binding DiscardCommand}" Style="{StaticResource ToolButton}" />
                        <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource ToolButton}" FontWeight="SemiBold" MinWidth="80" Margin="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="  • unsaved changes" VerticalAlignment="Bottom" Margin="0,0,0,3" FontWeight="SemiBold"
                                   Foreground="{DynamicResource LagoonSecondBrush}" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                           Text="Stages that are on are this list's stages: Random picks from them, and pressing X on Random in the game bans all the others. Hazards sets whether that stage starts with hazards on." />
                <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="10,7" CornerRadius="5" BorderThickness="1"
                        BorderBrush="{DynamicResource LagoonRuleBrush}" Background="{DynamicResource LagoonSurfaceBrush}">
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Margin="2,0,0,6">
                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                                        <Run Text="   " />
                                        <Run Text="{Binding Details, Mode=OneWay}" Foreground="{DynamicResource LagoonMutedBrush}" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Stages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- A stage tile: green edge when it's in the list -->
                                                <Border Width="272" Margin="0,0,8,8" Padding="10,6" CornerRadius="5" BorderThickness="1"
                                                        Background="{DynamicResource LagoonSurfaceBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource LagoonRuleBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource LagoonAccentBrush}" />
                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <DockPanel>
                                                        <CheckBox DockPanel.Dock="Right" Content="Hazards" IsChecked="{Binding HasHazards}" FontSize="12" MinWidth="0"
                                                                  Margin="8,0,0,0" AutomationProperties.Name="{Binding Name, StringFormat='Hazards on {0}'}" />
                                                        <CheckBox IsChecked="{Binding IsOn}" MinWidth="0" AutomationProperties.Name="{Binding Name}">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
