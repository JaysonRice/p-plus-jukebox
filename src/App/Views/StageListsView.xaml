<UserControl x:Class="PPlusTracklistEditor.App.Views.StageListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:stages="clr-namespace:PPlusTracklistEditor.Core.Stages;assembly=PPlusTracklistEditor.Core"
             x:Name="Root">
    <!-- The Stage Lists tab: the build's 8 presets on the left; on the right, page 1 as the game draws it, then every stage with its role. DataContext: StageListsViewModel. -->
    <UserControl.Resources>
        <!-- A stage in the page 1 preview: its game icon framed in its role color (cobalt = counterpick, green = starter);
             click to pick it. Without an icon, its name. -->
        <Style x:Key="PreviewIconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{Binding Tile.Name}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Tile.Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Ring" Margin="-5" CornerRadius="8" BorderThickness="3" BorderBrush="Transparent" />
                            <Border x:Name="Frame" CornerRadius="4" BorderThickness="3" Background="{DynamicResource LagoonSurfaceBrush}"
                                    BorderBrush="{DynamicResource LagoonAccentBrush}">
                                <Grid>
                                    <TextBlock Text="{Binding Tile.Name}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                               Margin="4" FontSize="12" FontWeight="SemiBold" />
                                    <Image Source="{Binding Tile.Icon}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tile.Role}" Value="{x:Static stages:StageRole.Counterpick}">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource LagoonSecondBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource LagoonMutedBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tile.IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource LagoonInkBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons for the picked stage that only show when they apply -->
        <Style x:Key="PickedButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A stage's icon in the lists below the preview -->
        <Style x:Key="SmallIcon" TargetType="Image">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="Source" Value="{Binding Icon}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A stage's box: edge colored by its role -->
        <Style x:Key="StageBox" TargetType="Border">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource LagoonSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LagoonRuleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="{x:Static stages:StageRole.Starter}">
                    <Setter Property="BorderBrush" Value="{DynamicResource LagoonAccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="{x:Static stages:StageRole.Counterpick}">
                    <Setter Property="BorderBrush" Value="{DynamicResource LagoonSecondBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Hazards-on marker for listed stages, while the Hazards boxes are hidden -->
        <Style x:Key="HazardMarker" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE946;" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource LagoonSecondBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ToolTip" Value="{Binding HazardMarkerTip}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding InList}" Value="True" />
                        <Condition Binding="{Binding HasHazards}" Value="True" />
                        <Condition Binding="{Binding DataContext.ShowHazards, ElementName=Root}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A stage in the list: a half-width row in the Starters or Counterpicks column -->
        <DataTemplate x:Key="ListedRow">
            <Border Style="{StaticResource StageBox}" Margin="0,0,0,6" Padding="10,3">
                <StackPanel>
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="126" MinWidth="0" Padding="9,5,0,6" Margin="8,0,0,0"
                                  ItemsSource="{Binding RoleOptions}" DisplayMemberPath="Label" SelectedValuePath="Role" SelectedValue="{Binding Role}"
                                  AutomationProperties.Name="{Binding Name, StringFormat='{}{0}: role'}" />
                        <CheckBox DockPanel.Dock="Right" Content="Hazards on" IsChecked="{Binding HasHazards}" FontSize="12" MinWidth="0"
                                  VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="{Binding HazardTip}"
                                  AutomationProperties.Name="{Binding Name, StringFormat='Hazards on {0}'}"
                                  Visibility="{Binding DataContext.ShowHazards, ElementName=Root, Converter={StaticResource BoolToVis}}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource HazardMarker}"
                                   AutomationProperties.Name="{Binding Name, StringFormat='{}{0}: hazards on'}" />
                        <Image DockPanel.Dock="Left" Style="{StaticResource SmallIcon}" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                    </DockPanel>
                    <!-- What the hazard switch does here, while "Advanced: hazards" is ticked -->
                    <TextBlock Text="{Binding HazardNote}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.ShowHazards, ElementName=Root}" Value="True" />
                                            <Condition Binding="{Binding HazardNote, Converter={StaticResource EmptyToVis}}" Value="Collapsed" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <TextBlock Text="This build has no stage lists. They come from your Project+ folder (pf\stage\switch)." Style="{StaticResource Hint}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"
                   Visibility="{Binding HasPresets, Converter={StaticResource InverseBoolToVis}}" />

        <Grid Visibility="{Binding HasPresets, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: the presets, in the order L/R cycles them on Random -->
            <DockPanel Margin="12,12,6,12">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="2,0,0,8"
                           Text="In the game, press L or R on Random to switch between these." />
                <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" AutomationProperties.Name="Stage list presets">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Right: the chosen preset -->
            <DockPanel Grid.Column="1" Margin="6,12,12,12">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="Discard changes" Command="{Binding DiscardCommand}" Style="{StaticResource ToolButton}" />
                        <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource ToolButton}" FontWeight="SemiBold" MinWidth="80" Margin="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" />
                        <Button Command="{Binding RenameCommand}" IsEnabled="{Binding CanRename}" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                                VerticalAlignment="Center" ToolTip="{Binding RenameHint}" ToolTipService.ShowOnDisabled="True"
                                AutomationProperties.Name="Rename preset" Content="&#xE70F;" />
                        <TextBlock Text="  • unsaved changes" VerticalAlignment="Bottom" Margin="0,0,0,3" FontWeight="SemiBold"
                                   Foreground="{DynamicResource LagoonSecondBrush}" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                    <!-- Right gutter: the scrollbar draws over the content, so keep the boxes clear of it -->
                    <StackPanel Margin="0,0,16,0">
                        <!-- Page 1 preview: each icon where the game draws it for this many stages -->
                        <Border Padding="14,10,14,12" CornerRadius="6" BorderThickness="1" Margin="0,0,0,14"
                                BorderBrush="{DynamicResource LagoonRuleBrush}" Background="{DynamicResource LagoonSurfaceBrush}">
                            <StackPanel>
                                <TextBlock Text="Page 1 in the game" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="{Binding Counts}" Style="{StaticResource Hint}" />

                                <Border HorizontalAlignment="Center" Margin="0,10,0,8" Padding="8" CornerRadius="6"
                                        Background="{DynamicResource LagoonEmptyBrush}">
                                    <ItemsControl ItemsSource="{Binding PreviewIcons}" AutomationProperties.Name="Page 1 preview" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Width="{Binding DataContext.PreviewWidth, ElementName=Root}"
                                                        Height="{Binding DataContext.PreviewHeight, ElementName=Root}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource PreviewIconButton}" Width="{Binding Width}" Height="{Binding Height}"
                                                        Command="{Binding DataContext.SelectStageCommand, ElementName=Root}" CommandParameter="{Binding Tile}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- What to do with the picked stage -->
                                <Grid MinHeight="34" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Click a stage above to move it or change its row."
                                               Visibility="{Binding HasPicked, Converter={StaticResource InverseBoolToVis}}" />
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasPicked, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding SelectedStage.Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Content="&#xE76B;" Command="{Binding MoveLeftCommand}" Style="{StaticResource IconButton}"
                                                ToolTip="Move left in its row" AutomationProperties.Name="Move left" />
                                        <Button Content="&#xE76C;" Command="{Binding MoveRightCommand}" Style="{StaticResource IconButton}" Margin="0,0,10,0"
                                                ToolTip="Move right in its row" AutomationProperties.Name="Move right" />
                                        <Button Content="Make it a starter" Command="{Binding MakeStarterCommand}" Style="{StaticResource PickedButton}"
                                                ToolTip="Move it to the bottom row" />
                                        <Button Content="Make it a counterpick" Command="{Binding MakeCounterpickCommand}" Style="{StaticResource PickedButton}"
                                                ToolTip="Move it to the top row" />
                                        <Button Content="Take out of the list" Command="{Binding TakeOutCommand}" Style="{StaticResource PickedButton}" Margin="0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource LagoonSecondBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text=" Counterpick (top row)" Margin="0,0,16,0" />
                                    <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource LagoonAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text=" Starter (bottom row)" />
                                </StackPanel>
                                <TextBlock Text="{Binding RowWarning}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" Foreground="{DynamicResource LagoonSecondBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RowWarning}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding LayoutNote}" TextWrapping="Wrap" Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LayoutNote}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- The stages in the list, in page order, one full-width row each -->
                        <DockPanel Margin="2,0,0,6">
                            <CheckBox DockPanel.Dock="Right" Content="Advanced: hazards" IsChecked="{Binding ShowHazards}" VerticalAlignment="Center"
                                      ToolTip="Show whether each stage starts with its hazards on" />
                            <StackPanel>
                                <TextBlock Text="In this list" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Text="Random picks from these stages, and pressing X on Random in the game bans all the others." />
                            </StackPanel>
                        </DockPanel>
                        <Border Margin="0,0,0,10" Padding="10,7" CornerRadius="5" BorderThickness="1"
                                BorderBrush="{DynamicResource LagoonSecondBrush}" Visibility="{Binding ShowHazards, Converter={StaticResource BoolToVis}}">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Hazards sets whether a stage starts with its hazards on (players can still switch them with Z on the stage select screen). Stages you add start with hazards off, except Fountain of Dreams." />
                        </Border>
                        <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,8" TextWrapping="Wrap"
                                   Text="No stages yet. Make stages below starters or counterpicks to add them (up to 10)."
                                   Visibility="{Binding HasListed, Converter={StaticResource InverseBoolToVis}}" />
                        <Grid Margin="0,0,0,10" Visibility="{Binding HasListed, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource LagoonAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ListedStarters.Count, StringFormat=' Starters ({0}), bottom row'}" FontWeight="SemiBold" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding ListedStarters}" ItemTemplate="{StaticResource ListedRow}" AutomationProperties.Name="Starters" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource LagoonSecondBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ListedCounterpicks.Count, StringFormat=' Counterpicks ({0}), top row'}" FontWeight="SemiBold" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding ListedCounterpicks}" ItemTemplate="{StaticResource ListedRow}" AutomationProperties.Name="Counterpicks" />
                            </StackPanel>
                        </Grid>

                        <!-- The stages not in the list, A to Z, with a search -->
                        <StackPanel Margin="2,4,0,8">
                            <TextBlock Text="Add stages" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="Make a stage a starter or counterpick to move it into the list." />
                        </StackPanel>
                        <Grid Margin="0,0,8,10" HorizontalAlignment="Left">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Width="420"
                                     AutomationProperties.Name="Find a stage" />
                            <TextBlock Text="Find a stage" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.5"
                                       Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,8" Text="No stages outside the list match that."
                                   Visibility="{Binding NoMatches, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Unlisted}" AutomationProperties.Name="Stages not in the list">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StageBox}" Width="278" Margin="0,0,8,8">
                                        <DockPanel>
                                            <Image DockPanel.Dock="Left" Style="{StaticResource SmallIcon}" Width="64" Height="56" VerticalAlignment="Top" Margin="0,0,10,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,0,4" />
                                                <ComboBox Width="140" MinWidth="0" Padding="9,5,0,6" HorizontalAlignment="Left"
                                                          ItemsSource="{Binding RoleOptions}" DisplayMemberPath="Label" SelectedValuePath="Role" SelectedValue="{Binding Role}"
                                                          AutomationProperties.Name="{Binding Name, StringFormat='{}{0}: role'}" />
                                                <CheckBox Content="Starts with hazards on" IsChecked="{Binding HasHazards}" ToolTip="{Binding HazardTip}" FontSize="12" MinWidth="0" Margin="0,4,0,0"
                                                          AutomationProperties.Name="{Binding Name, StringFormat='Hazards on {0}'}"
                                                          Visibility="{Binding DataContext.ShowHazards, ElementName=Root, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
