<Window x:Class="PPlusTracklistEditor.App.Views.SetupWindow" Background="{DynamicResource LagoonWindowBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="P+ Tracklist Editor – first time setup" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="Where is your Project+ folder?" Style="{StaticResource Heading}" Margin="0,0,0,8" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16">
            Pick the "Project+" folder from your SD card or your computer. The app copies its songs and stage song lists
            into your own library, as a build called "Default". Your Project+ folder isn't changed.
        </TextBlock>
        <DockPanel Margin="0,0,0,8">
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Padding="14,4" Margin="8,0,0,0" />
            <TextBox x:Name="FolderBox" IsReadOnly="True" Padding="6,4" />
        </DockPanel>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,4,0,8" />
        <ProgressBar x:Name="Progress" Height="8" Margin="0,0,0,8" Visibility="Collapsed" />
        <TextBlock x:Name="LibraryText" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Padding="16,4" Margin="0,0,8,0" />
            <Button x:Name="StartButton" Content="Start" IsDefault="True" IsEnabled="False" Click="Start_Click" Padding="20,4" FontWeight="SemiBold" />
        </StackPanel>
    </StackPanel>
</Window>
