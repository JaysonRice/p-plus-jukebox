<Window x:Class="PPlusTracklistEditor.App.Views.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PPlusTracklistEditor.App.Views"
        Title="{Binding Heading}" Width="1000" Height="680" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Picker for "Add from your library": the same list as the Song library tab, with multi-select. -->
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" Style="{StaticResource Heading}" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Text="Select one or more songs (Ctrl+click to pick several), then Add. Double-click adds one right away."
                   Style="{StaticResource Hint}" Margin="0,0,0,10" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="16,4" Margin="0,0,8,0" />
            <Button Content="Add selected songs" Click="Add_Click" IsDefault="True" Padding="16,4" FontWeight="SemiBold" />
        </StackPanel>
        <views:LibraryView x:Name="List" />
    </DockPanel>
</Window>
