<Window x:Class="PPlusTracklistEditor.App.Views.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Heading}" Width="860" Height="640" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" Style="{StaticResource Heading}" Margin="0,0,0,10" />

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <CheckBox DockPanel.Dock="Right" Content="Only songs no build uses" IsChecked="{Binding OnlyUnused}" VerticalAlignment="Center" Margin="12,0,0,0"
                      Visibility="{Binding IsPicking, Converter={StaticResource InverseBoolToVis}}" />
            <Grid>
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                <TextBlock Text="Search songs (title or series)" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.5"
                           Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
            </Grid>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Close" IsCancel="True" Padding="16,4" Margin="8,0,0,0" />
                <Button Content="Add selected songs" Click="Add_Click" IsDefault="True" Padding="16,4" Margin="8,0,0,0" FontWeight="SemiBold"
                        Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Play / Stop" Command="{Binding PlayCommand}" Style="{StaticResource ToolButton}" ToolTip="Space" />
                <Button Content="Delete song…" Command="{Binding DeleteCommand}" Style="{StaticResource ToolButton}"
                        Visibility="{Binding IsPicking, Converter={StaticResource InverseBoolToVis}}"
                        ToolTip="Only songs no build uses can be deleted" />
                <Button Content="Show in Explorer" Command="{Binding ShowInExplorerCommand}" Style="{StaticResource ToolButton}" />
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Hint}" />
            <TextBlock Text="{Binding SelectedDetails}" TextWrapping="Wrap" />
        </DockPanel>

        <DataGrid x:Name="SongGrid" ItemsSource="{Binding SongsView}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                  CanUserReorderColumns="False" MouseDoubleClick="SongGrid_DoubleClick" PreviewKeyDown="SongGrid_PreviewKeyDown">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Song" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Series" Binding="{Binding Series}" Width="*" />
                <DataGridTextColumn Header="Used by" Binding="{Binding UsedByText}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
