<Window x:Class="PPlusTracklistEditor.App.Views.ImportSongsWindow" Background="{DynamicResource LagoonWindowBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add songs to your library" Width="900" Height="560" MinWidth="680" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="These songs will be copied into your library. Check each title (it's what the game's song menu shows). A series is the folder a song is kept in, like &quot;Kirby&quot;; it's optional." />

        <!-- Same series for everything -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Series for all of them:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="AllSeriesBox" IsEditable="True" MinWidth="220" Margin="0,0,8,0" AutomationProperties.Name="Series for all songs" />
            <Button Content="Apply to all" Click="ApplyAll_Click" Padding="12,3" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <CheckBox x:Name="RemoveOriginalsBox" Margin="0,0,0,12"
                      Content="Move the original files to the Recycle Bin after adding them" />
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Hint}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Padding="16,4" Margin="0,0,8,0" />
                    <Button x:Name="AddButton" Content="Add songs" IsDefault="True" Click="Add_Click" Padding="24,4" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                  CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                  AutomationProperties.Name="Songs to add">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Add" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="52" />
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" IsReadOnly="True" Width="1.2*" />
                <DataGridTextColumn Header="Title" Binding="{Binding Title, UpdateSourceTrigger=LostFocus}" Width="1.6*" />
                <DataGridTemplateColumn Header="Series (optional)" Width="1.2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Series}" Margin="4,0" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True" Text="{Binding Series, UpdateSourceTrigger=LostFocus}"
                                      ItemsSource="{Binding DataContext.SeriesOptions, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="" Binding="{Binding Note}" IsReadOnly="True" Width="1.8*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Opacity" Value="0.75" /></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
