<UserControl x:Class="PPlusTracklistEditor.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PPlusTracklistEditor.App.Views">
    <DockPanel>
        <!-- Find: search, which builds use it, sort, grouping -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid DockPanel.Dock="Left" Width="280" Margin="0,0,12,0">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="6,4" />
                <TextBlock Text="Search songs (title or series)" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.5"
                           Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
            </Grid>
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding UsageOptions}" SelectedItem="{Binding Usage}" DisplayMemberPath="Label" MinWidth="190" Margin="0,0,12,0"
                          AutomationProperties.Name="Show songs" />
                <TextBlock Text="Sort:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" DisplayMemberPath="Label" MinWidth="170" Margin="0,0,12,0"
                          AutomationProperties.Name="Sort songs" />
                <CheckBox Content="Group by series" IsChecked="{Binding GroupBySeries}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding GroupBySeries, Converter={StaticResource BoolToVis}}">
                    <Button Content="Expand all" Command="{Binding ExpandAllCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="Collapse all" Command="{Binding CollapseAllCommand}" Style="{StaticResource ToolButton}" />
                </StackPanel>
            </WrapPanel>
        </DockPanel>

        <!-- Player strip: the selected song's timeline (loop shown, not editable); click or drag it to skip around -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,8" CornerRadius="6" BorderThickness="1" BorderBrush="#40808080"
                DataContext="{Binding Preview}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasLoop, Converter={StaticResource BoolToVis}}">
                        <Rectangle Width="12" Height="10" Fill="#40808080" Stroke="#60808080" Margin="0,0,4,0" />
                        <TextBlock Text="Intro (plays once)" Style="{StaticResource Hint}" Margin="0,0,12,0" />
                        <Rectangle Width="12" Height="10" Fill="Transparent" Stroke="#60808080" Margin="0,0,4,0" />
                        <TextBlock Text="Loop (repeats)" Style="{StaticResource Hint}" Margin="0,0,12,0" />
                        <Rectangle Width="12" Height="10" Fill="#90808080" Stroke="#60808080" Margin="0,0,4,0" />
                        <TextBlock Text="Never plays" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="   " />
                        <Run Text="{Binding LoopText, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
                <Button DockPanel.Dock="Left" Content="{Binding PlayPauseText}" Command="{Binding TogglePlayCommand}" Width="96" VerticalAlignment="Center"
                        FontWeight="SemiBold" ToolTip="Play or pause (Space)" AutomationProperties.Name="Play or pause song" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontFamily="Consolas" VerticalAlignment="Center" MinWidth="150" TextAlignment="Right" />
                <Grid Height="104" Margin="10,0">
                    <views:WaveformView x:Name="Timeline" Waveform="{Binding Waveform}" CanEditLoop="False"
                                        ShowLoop="{Binding HasLoop}" LoopStart="{Binding LoopStart, Mode=OneWay}" LoopEnd="{Binding LoopEnd, Mode=OneWay}"
                                        Playhead="{Binding Playhead}" ViewStart="{Binding ViewStart}" ViewLength="{Binding ViewLength}"
                                        AutomationProperties.Name="Song timeline" />
                    <TextBlock Text="Pick a song in the list to see and hear it here." Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSong, Converter={StaticResource InverseBoolToVis}}" />
                    <TextBlock Text="Loadingâ€¦" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Actions on the selected song -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Delete songâ€¦" Command="{Binding DeleteCommand}" Style="{StaticResource ToolButton}"
                        Visibility="{Binding IsPicking, Converter={StaticResource InverseBoolToVis}}"
                        ToolTip="Only songs no build uses can be deleted" />
                <Button Content="Show in Explorer" Command="{Binding ShowInExplorerCommand}" Style="{StaticResource ToolButton}" />
                <TextBlock Text="{Binding SelectedDetails}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,12,0" />
            </StackPanel>
        </DockPanel>

        <!-- One flat list: series header rows + song rows (fast: only visible rows are built). Click a header to collapse it. -->
        <DataGrid x:Name="SongGrid" ItemsSource="{Binding RowsView}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                  CanUserReorderColumns="False" CanUserSortColumns="False"
                  VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                  MouseDoubleClick="SongGrid_DoubleClick" PreviewKeyDown="SongGrid_PreviewKeyDown"
                  PreviewMouseLeftButtonUp="SongGrid_PreviewMouseLeftButtonUp"
                  AutomationProperties.Name="Songs in your library">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="Click to show or hide this series" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Song" Binding="{Binding DisplayText}" Width="3*">
                    <DataGridTextColumn.ElementStyle>
                        <!-- Songs sit indented under their series header while grouping. -->
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsHeader}" Value="False" />
                                        <Condition Binding="{Binding DataContext.GroupBySeries, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Margin" Value="22,0,0,0" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="SeriesColumn" Header="Series" Binding="{Binding Series}" Width="1.5*" />
                <DataGridTextColumn Header="Length" Binding="{Binding LengthText}" Width="70" />
                <DataGridTextColumn Header="Loop" Binding="{Binding LoopText}" Width="85" />
                <DataGridTextColumn Header="Used by" Binding="{Binding UsedByText}" Width="2*" />
                <DataGridTextColumn Header="Added" Binding="{Binding AddedText}" Width="95" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
