<UserControl x:Class="PPlusTracklistEditor.App.Views.LibraryView" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Background="Transparent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PPlusTracklistEditor.App.Views">
    <DockPanel>
        <!-- Find: search, which builds use it, sort, grouping -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid DockPanel.Dock="Left" Width="230" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="6,4" />
                <TextBlock Text="Search songs (title or series)" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.5"
                           Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
            </Grid>
            <!-- Far right of the filter row -->
            <Button DockPanel.Dock="Right" Content="Add BRSTM files" Command="{Binding AddFilesCommand}" FontWeight="Bold" Padding="14,5" Margin="12,0,0,0"
                    VerticalAlignment="Center" Visibility="{Binding IsPicking, Converter={StaticResource InverseBoolToVis}}"
                    ToolTip="Add songs other people made (BRSTM files) to your library. Pick several at once, or drag files or whole folders onto the song list. You can choose a title and series for each before they're added."
                    AutomationProperties.Name="Add BRSTM files" />
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding UsageOptions}" SelectedItem="{Binding Usage}" DisplayMemberPath="Label" MinWidth="172" Margin="0,0,10,0"
                          AutomationProperties.Name="Show songs" />
                <TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" DisplayMemberPath="Label" MinWidth="112" Margin="0,0,10,0"
                          ToolTip="Click a column heading in the table to flip the order (A to Z / Z to A, shortest / longest...)"
                          AutomationProperties.Name="Sort songs" />
                <CheckBox Content="Group by series" IsChecked="{Binding GroupBySeries}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding GroupBySeries, Converter={StaticResource BoolToVis}}">
                    <Button Content="Expand all" Command="{Binding ExpandAllCommand}" Style="{StaticResource ToolButton}" Padding="8,4" Margin="0,0,4,0" />
                    <Button Content="Collapse all" Command="{Binding CollapseAllCommand}" Style="{StaticResource ToolButton}" Padding="8,4" Margin="0" />
                </StackPanel>
            </WrapPanel>
        </DockPanel>

        <!-- Player strip: a simple timeline of the selected song (loop shown, not editable); click or drag it to skip around -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,8" CornerRadius="6" BorderThickness="1" BorderBrush="#40808080"
                DataContext="{Binding Preview}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasLoop, Converter={StaticResource BoolToVis}}">
                        <Rectangle Width="12" Height="8" Fill="#702F80ED" Margin="0,0,4,0" />
                        <TextBlock Text="Intro" Style="{StaticResource Hint}" Margin="0,0,12,0" />
                        <Rectangle Width="12" Height="8" Fill="#2F80ED" Margin="0,0,4,0" />
                        <TextBlock Text="Loop" Style="{StaticResource Hint}" Margin="0,0,12,0" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasUnplayedEnd, Converter={StaticResource BoolToVis}}">
                            <Rectangle Width="12" Height="8" Fill="#60808080" Margin="0,0,4,0" />
                            <TextBlock Text="Never plays" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="   " />
                        <Run Text="{Binding LoopText, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
                <Button DockPanel.Dock="Left" Content="{Binding PlayPauseText}" Command="{Binding TogglePlayCommand}" Width="96" VerticalAlignment="Center"
                        FontWeight="SemiBold" ToolTip="Play or pause (Space)" AutomationProperties.Name="Play or pause song" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontFamily="Consolas" VerticalAlignment="Center" MinWidth="150" TextAlignment="Right" />
                <Grid Height="32" Margin="12,0">
                    <views:SongTimeline x:Name="Timeline" Length="{Binding Length}" HasLoop="{Binding HasLoop}"
                                        LoopStart="{Binding LoopStart, Mode=OneWay}" LoopEnd="{Binding LoopEnd, Mode=OneWay}"
                                        Playhead="{Binding Playhead}" AutomationProperties.Name="Song timeline"
                                        Visibility="{Binding HasSong, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="Pick a song in the list to see and hear it here." Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSong, Converter={StaticResource InverseBoolToVis}}" />
                    <TextBlock Text="Loading…" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Actions on the selected song -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Add to a stage…" Command="{Binding AddToStageCommand}" Style="{StaticResource ToolButton}" FontWeight="SemiBold"
                        Visibility="{Binding IsPicking, Converter={StaticResource InverseBoolToVis}}"
                        ToolTip="Choose a stage in the current build to add the selected song to" />
                <Button Content="Delete song…" Command="{Binding DeleteCommand}" Style="{StaticResource ToolButton}"
                        Visibility="{Binding IsPicking, Converter={StaticResource InverseBoolToVis}}"
                        ToolTip="Only songs no build uses can be deleted" />
                <Button Content="Show in Explorer" Command="{Binding ShowInExplorerCommand}" Style="{StaticResource ToolButton}" />
                <TextBlock Text="{Binding SelectedDetails}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,12,0" />
            </StackPanel>
        </DockPanel>

        <!-- One flat list: series header rows + song rows (fast: only visible rows are built). Click a header to collapse it. -->
        <DataGrid x:Name="SongGrid" ItemsSource="{Binding RowsView}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                  CanUserReorderColumns="False" CanUserSortColumns="True" Sorting="SongGrid_Sorting"
                  VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                  MouseDoubleClick="SongGrid_DoubleClick" PreviewKeyDown="SongGrid_PreviewKeyDown"
                  PreviewMouseLeftButtonUp="SongGrid_PreviewMouseLeftButtonUp"
                  AutomationProperties.Name="Songs in your library">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="Click to show or hide this series" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Song" Binding="{Binding DisplayText}" Width="3*">
                    <DataGridTextColumn.ElementStyle>
                        <!-- Songs sit indented under their series header while grouping. -->
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding NameTooltip}" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsHeader}" Value="False" />
                                        <Condition Binding="{Binding DataContext.GroupBySeries, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Margin" Value="22,0,0,0" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="SeriesColumn" Header="Series" Binding="{Binding Series}" Width="1.5*" />
                <DataGridTextColumn Header="Length" Binding="{Binding LengthText}" Width="70" />
                <!-- How many builds use the song; hover to see which -->
                <DataGridTextColumn Header="Build count" Binding="{Binding BuildCountText}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center" />
                            <Setter Property="ToolTip" Value="{Binding BuildsTooltip}" />
                            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Added" Binding="{Binding AddedText}" Width="95" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
