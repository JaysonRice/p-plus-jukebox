<Window x:Class="PPlusTracklistEditor.App.Views.MainWindow" Background="{DynamicResource LagoonTitleBarBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PPlusTracklistEditor.App.ViewModels"
        xmlns:views="clr-namespace:PPlusTracklistEditor.App.Views"
        xmlns:core="clr-namespace:PPlusTracklistEditor.Core.Library;assembly=PPlusTracklistEditor.Core"
        Title="{Binding WindowTitle}" Width="1200" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Editor.SaveCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding Editor.UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding Editor.RedoCommand}" />
    </Window.InputBindings>

    <DockPanel Background="{DynamicResource LagoonWindowBrush}">
        <!-- Top: a deep green band (the title bar) with white text -->
        <Border DockPanel.Dock="Top" Padding="12,10" Background="{DynamicResource LagoonTitleBarBrush}" TextElement.Foreground="{DynamicResource LagoonOnTitleBarBrush}">
            <DockPanel>
                <!-- Right: Settings (gear) and the sync button, small but filled with the main color so it stands out -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE713;" Command="{Binding OpenSettingsCommand}" Style="{StaticResource IconButton}"
                            ToolTip="Settings: light or dark, and the Project+ folder to sync to" AutomationProperties.Name="Settings" />
                    <Button Command="{Binding SyncCommand}" Style="{StaticResource TitleBarSyncButton}" Width="38" Height="32" Padding="0"
                            AutomationProperties.Name="Put on my Project+" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="20000">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" />
                        <Button.ToolTip>
                            <StackPanel MaxWidth="320">
                                <TextBlock Text="Put this build on my Project+" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock TextWrapping="Wrap"
                                           Text="Copies this build's music to your SD card or Project+ folder (the one saved in Settings, if you set one). You'll see what will change first, and nothing is written until you confirm." />
                            </StackPanel>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Menu VerticalAlignment="Center" Margin="0,0,16,0" Background="Transparent">
                        <MenuItem AutomationProperties.Name="Builds menu">
                            <!-- Only the header is white (on the green band); the dropdown keeps normal text colors. -->
                            <MenuItem.Header>
                                <AccessText Text="_Builds" Foreground="{DynamicResource LagoonOnTitleBarBrush}" />
                            </MenuItem.Header>
                            <MenuItem Header="_New build…" Command="{Binding NewBuildCommand}"
                                      ToolTip="Make a new build as a copy of the current one" />
                            <MenuItem Header="_Rename build…" Command="{Binding RenameBuildCommand}" />
                            <MenuItem Header="_Delete build…" Command="{Binding DeleteBuildCommand}"
                                      ToolTip="Deletes the current build's stage song lists. The Default build can't be deleted." />
                            <Separator />
                            <MenuItem Header="_Import a music folder…" Command="{Binding ImportMusicFolderCommand}"
                                      ToolTip="Turn a folder with strm and tracklist inside (for example from someone's build) into a new build" />
                        </MenuItem>
                    </Menu>
                    <TextBlock Text="Current build:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Builds}" SelectedItem="{Binding SelectedBuild}" DisplayMemberPath="Name" Background="{DynamicResource LagoonSurfaceBrush}"
                              MinWidth="220" ToolTip="A build is a full set of stage music. Switch between them any time." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bottom: where the library is, and what's playing -->
        <Border DockPanel.Dock="Bottom" Padding="12,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                Visibility="{Binding ShowFooter, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding Player.NowPlaying, Converter={StaticResource NotNullToVis}}">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                        <Run Text="♪" /> <Run Text="{Binding Player.NowPlaying, Mode=OneWay}" />
                        <Run FontStyle="Italic">
                            <Run.Style>
                                <Style TargetType="Run">
                                    <Setter Property="Text" Value="" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Player.IsLoading}" Value="True">
                                            <Setter Property="Text" Value="(loading…)" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Run.Style>
                        </Run>
                    </TextBlock>
                    <Button Content="Stop" Command="{Binding StopPlaybackCommand}" Padding="10,2" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding LibraryNotice}" VerticalAlignment="Center" Style="{StaticResource Hint}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTab}" Margin="8,6,8,0">
          <TabItem Header="Stages">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: stages -->
            <DockPanel Margin="12,12,6,12">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    <TextBlock Text="Search stages" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.5"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
                </Grid>
                <ListBox ItemsSource="{Binding StagesView}" SelectedItem="{Binding SelectedStage}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Stages">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StageCardViewModel}">
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right: nothing picked yet -->
            <TextBlock Grid.Column="2" Text="Pick a stage on the left to see and change its music."
                       HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}" FontSize="16"
                       Visibility="{Binding HasEditor, Converter={StaticResource InverseBoolToVis}}" />

            <!-- Right: the stage editor -->
            <DockPanel Grid.Column="2" Margin="6,12,12,12" DataContext="{Binding Editor}"
                       Visibility="{Binding DataContext.HasEditor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <!-- Undo and redo are keyboard-only (Ctrl+Z / Ctrl+Y); the buttons weren't worth the room -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="Discard changes" Command="{Binding DiscardCommand}" Style="{StaticResource ToolButton}" />
                        <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource ToolButton}" FontWeight="SemiBold" MinWidth="80" Margin="0"
                                ToolTip="Ctrl+S" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StageTitle}" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="  • unsaved changes" VerticalAlignment="Bottom" Margin="0,0,0,3" Style="{StaticResource Hint}"
                                   Foreground="{DynamicResource LagoonSecondBrush}" Opacity="1" FontWeight="SemiBold"
                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>

                <!-- One text button for the main job, small symbol buttons for the rest (hover for what they do). Wraps when narrow. -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="Add from your library" Command="{Binding AddFromLibraryCommand}" Style="{StaticResource ToolButton}"
                            FontWeight="SemiBold" Height="32" Margin="0,0,14,0"
                            ToolTip="Choose songs from your Song Library to add to this stage" />
                    <Button Content="&#xE74A;" Command="{Binding MoveUpCommand}" Style="{StaticResource IconButton}"
                            ToolTip="Move the selected song up" AutomationProperties.Name="Move up" />
                    <Button Content="&#xE74B;" Command="{Binding MoveDownCommand}" Style="{StaticResource IconButton}"
                            ToolTip="Move the selected song down" AutomationProperties.Name="Move down" />
                    <Button Content="&#xE74D;" Command="{Binding RemoveCommand}" Style="{StaticResource IconButton}"
                            ToolTip="Take the selected song off this stage. It stays in your library. (Delete key)" AutomationProperties.Name="Remove from this stage" Margin="0,0,14,0" />
                    <Button Content="Reset to default songs" Command="{Binding ResetToDefaultCommand}" Style="{StaticResource ToolButton}" Height="32"
                            Visibility="{Binding CanResetToDefault, Converter={StaticResource BoolToVis}}" />
                </WrapPanel>

                <!-- Problems, in sentences -->
                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,6" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                    <StackPanel>
                        <TextBlock Text="✓ No problems found on this stage." Visibility="{Binding HasNoProblems, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Problems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:Problem}">
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Width="22" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="⚠" />
                                                    <Setter Property="Foreground" Value="DarkOrange" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                            <Setter Property="Text" Value="✖" />
                                                            <Setter Property="Foreground" Value="Crimson" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Selected song's settings -->
                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,8" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        DataContext="{Binding SelectedSong}"
                        Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=DockPanel}, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Title" VerticalAlignment="Center" Margin="0,0,12,6" />
                        <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                 ToolTip="The name shown in the game's song menu" />

                        <TextBlock Grid.Row="1" Text="Volume" VerticalAlignment="Center" Margin="0,0,12,6" />
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Width="90" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Run Text="{Binding Volume, Mode=OneWay}" /><Run Text=" (80 = normal)" FontSize="11" />
                            </TextBlock>
                            <Slider Minimum="0" Maximum="{Binding VolumeMax, Mode=OneTime}" Value="{Binding Volume}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" VerticalAlignment="Center"
                                    ToolTip="Play the song while you drag to hear the change" />
                        </DockPanel>

                        <TextBlock Grid.Row="2" Text="How often" VerticalAlignment="Center" Margin="0,0,12,6" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                            <ComboBox ItemsSource="{x:Static core:SongFrequency.Choices}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding FrequencyChoice}" MinWidth="170" />
                            <TextBlock Text="{Binding HowOftenText}" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource Hint}"
                                       ToolTip="The chance this song is picked when the stage starts" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="Song file" VerticalAlignment="Center" Margin="0,0,12,6" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SourceText}" TextWrapping="Wrap" Margin="0,0,0,6" Style="{StaticResource Hint}" />

                        <Expander Grid.Row="4" Grid.ColumnSpan="2" Header="Advanced">
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Song ID" Margin="0,0,12,6" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SongIdText}" VerticalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Grid.Column="2" Text="Set automatically, unique on this stage." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,6" />

                                <TextBlock Grid.Row="1" Text="Delay" Margin="0,0,12,6" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Delay}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Frames before the song starts (60 = 1 second). Most songs use 0." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,6" />

                                <TextBlock Grid.Row="2" Text="Song switch" Margin="0,0,12,6" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SongSwitch}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="For stages whose music changes during a match. Most songs use 0." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,6" />

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal">
                                    <CheckBox Content="Don't speed up at low time (no hurry-up music)" IsChecked="{Binding DisableStockPinch}" Margin="0,0,16,0" />
                                    <CheckBox Content="Hide from the in-game song list" IsChecked="{Binding HiddenFromTracklist}" />
                                </StackPanel>
                            </Grid>
                        </Expander>
                    </Grid>
                </Border>

                <!-- Player bar for the selected song (the same one as in the Song Library), right under the list -->
                <views:SongPlayerStrip DockPanel.Dock="Bottom" Margin="0,8,0,0" DataContext="{Binding Preview}" />

                <!-- The songs -->
                <DataGrid x:Name="SongGrid" ItemsSource="{Binding Songs}" SelectedItem="{Binding SelectedSong}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          CanUserSortColumns="False" CanUserReorderColumns="False" GridLinesVisibility="None"
                          MouseDoubleClick="SongGrid_DoubleClick"
                          AutomationProperties.Name="Songs on this stage">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                    <Setter Property="Foreground" Value="Crimson" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="36" />
                        <DataGridTextColumn Header="Title" Binding="{Binding DisplayTitle}" Width="2*" />
                        <DataGridTextColumn Header="How often" Binding="{Binding HowOftenText}" Width="130" />
                        <DataGridTextColumn Header="Volume" Binding="{Binding Volume}" Width="70" />
                        <DataGridTextColumn Header="Song file" Binding="{Binding SourceText}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
          </TabItem>
          <TabItem Header="Song Library">
            <views:LibraryView DataContext="{Binding LibraryTab}" Margin="4,12,4,8" />
          </TabItem>
          <TabItem Header="Loop Maker">
            <views:LoopMakerView DataContext="{Binding LoopMaker}" />
          </TabItem>
        </TabControl>
    </DockPanel>
</Window>
