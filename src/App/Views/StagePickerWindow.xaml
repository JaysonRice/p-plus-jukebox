<Window x:Class="PPlusTracklistEditor.App.Views.StagePickerWindow" Background="{DynamicResource LagoonWindowBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add to a stage" Width="460" Height="560" MinWidth="360" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <TextBlock x:Name="Prompt" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="16,4" Margin="0,0,8,0" />
            <Button Content="Add to this stage" IsDefault="True" Click="Ok_Click" Padding="20,4" FontWeight="SemiBold" />
        </StackPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox" Padding="6,4" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Search stages" />
            <TextBlock Text="Search stages" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.5"
                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVis}}" />
        </Grid>
        <ListBox x:Name="List" MouseDoubleClick="List_DoubleClick" AutomationProperties.Name="Stages">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
