<Window x:Class="PPlusTracklistEditor.App.Views.SyncWindow" Background="{DynamicResource LagoonWindowBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync to your Project+" Width="620" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Messages you can select and copy (Ctrl+C), but that still look like plain text -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            <!-- Just the text: no box, hover fill or focus underline from the Fluent theme -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Heading}" Style="{StaticResource Heading}" Margin="0,0,0,8" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14">
            Choose the Project+ folder to put this build on: your SD card, or any Project+ folder on your computer.
            Sync updates its music, stage lists and preset names. Songs that no stage uses anymore are removed from there, but they stay in your library.
        </TextBlock>
        <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Padding="14,4" Margin="8,0,0,0" IsEnabled="{Binding IsIdle}" />
            <Button DockPanel.Dock="Right" Content="Check again" Command="{Binding CheckAgainCommand}" Padding="14,4" Margin="8,0,0,0"
                    Visibility="{Binding IsKnownFolderMissing, Converter={StaticResource BoolToVis}}" />
            <TextBox Text="{Binding Folder, Mode=OneWay}" IsReadOnly="True" Padding="6,4" AutomationProperties.Name="Project+ folder" />
        </DockPanel>
        <CheckBox Content="Always use this folder (you can change it in Settings)" IsChecked="{Binding RememberFolder}" Margin="0,0,0,12" />
        <!-- This Project+ changed (e.g. a Project+ update): offer to bring the app's Project+ original up to date first -->
        <Border Padding="12,10" CornerRadius="4" BorderThickness="2" Margin="0,0,0,12" BorderBrush="{DynamicResource LagoonSecondBrush}"
                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="This Project+ looks updated" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding UpdateText, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,0,0,8" AutomationProperties.Name="What changed in this Project+" />
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Updating gives the app these Project+ songs, stages and pictures. Your builds keep their songs (new stages are added to them), and everything replaced is backed up first. Best done before you sync." />
                <Button Content="Update the app from this Project+" Command="{Binding UpdateAppCommand}" HorizontalAlignment="Left" Padding="14,4" FontWeight="SemiBold" />
            </StackPanel>
        </Border>
        <Border Padding="12,10" CornerRadius="4" BorderThickness="1" Margin="0,0,0,12" MinHeight="70"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <TextBox Text="{Binding Summary, Mode=OneWay}" Style="{StaticResource SelectableText}" AutomationProperties.Name="Sync summary" />
        </Border>
        <ProgressBar Height="8" Maximum="1" Value="{Binding Progress}" Margin="0,0,0,16"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" IsCancel="True" Padding="16,4" Margin="0,0,8,0" IsEnabled="{Binding IsIdle}" />
            <Button Content="Sync" Command="{Binding SyncCommand}" IsDefault="True" Padding="20,4" FontWeight="SemiBold" />
        </StackPanel>
    </StackPanel>
</Window>
