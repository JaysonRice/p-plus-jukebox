<Window x:Class="PPlusTracklistEditor.App.Views.SettingsWindow" Background="{DynamicResource LagoonWindowBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="Settings" Style="{StaticResource Heading}" Margin="0,0,0,18" />

        <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <RadioButton Content="Follow Windows" GroupName="Theme" IsChecked="{Binding FollowWindows}" Margin="0,0,20,0" />
            <RadioButton Content="Light" GroupName="Theme" IsChecked="{Binding Light}" Margin="0,0,20,0" />
            <RadioButton Content="Dark" GroupName="Theme" IsChecked="{Binding Dark}" />
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,22"
                   Text="Follow Windows switches with your Windows light or dark setting." />

        <TextBlock Text="Project+ folder for syncing" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                   Text="When this is set, the sync button goes straight to this folder (your SD card or a Project+ folder on your computer). You still see what will change before anything is copied." />
        <DockPanel Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Content="Change" Command="{Binding ChangeSyncFolderCommand}" Padding="14,4" Margin="0,0,6,0" />
                <Button Content="Forget" Command="{Binding ForgetSyncFolderCommand}" Padding="14,4"
                        IsEnabled="{Binding HasSyncFolder}" ToolTip="Stop using a saved folder. Each build then remembers where it was last put." />
            </StackPanel>
            <TextBox Text="{Binding SyncFolderText, Mode=OneWay}" IsReadOnly="True" Padding="6,4" AutomationProperties.Name="Saved sync folder" />
        </DockPanel>
        <TextBlock Text="{Binding SyncFolderStatus}" Style="{StaticResource Hint}" Margin="0,0,0,22" />

        <Button Content="Done" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Padding="24,4" FontWeight="SemiBold" />
    </StackPanel>
</Window>
