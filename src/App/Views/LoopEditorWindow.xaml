<Window x:Class="PPlusTracklistEditor.App.Views.LoopEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PPlusTracklistEditor.App.Views"
        Title="Make a looping song" Width="1040" Height="720" MinWidth="760" MinHeight="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Opens when an audio file (or "Change the loop…") is added to a stage. The Loop Maker tab uses the same LoopEditorView. -->
    <DockPanel Margin="20,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="16,4" Margin="0,0,8,0" />
            <Button Content="Make song" IsDefault="True" Click="Make_Click" Padding="24,4" FontWeight="SemiBold" IsEnabled="{Binding IsReady}" />
        </StackPanel>
        <views:LoopEditorView x:Name="Editor" />
    </DockPanel>
</Window>
