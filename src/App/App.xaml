<Application x:Class="PPlusTracklistEditor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PPlusTracklistEditor.App.Views"
             ThemeMode="System"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:NotNullToVisibilityConverter x:Key="NotNullToVis" />
        <views:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- The Fluent theme leaves a table's body white in dark mode, so its rows are painted from the Lagoon panel and text colors. -->
        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="Background" Value="{DynamicResource LagoonSurfaceBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource LagoonSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource LagoonInkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LagoonRuleBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LagoonRuleBrush}" />
        </Style>
        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="{DynamicResource LagoonSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource LagoonInkBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource LagoonAccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource LagoonOnAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Lists sit on the Lagoon panel color too (the theme's own is a neutral gray that dulls the green beside it). -->
        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="{DynamicResource LagoonSurfaceBrush}" />
        </Style>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource LagoonAccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource LagoonOnAccentBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- A small square button with a symbol (Segoe Fluent Icons; Segoe MDL2 Assets on older Windows). Always give it a ToolTip and an AutomationProperties.Name. -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
        </Style>
        <!-- Play buttons: filled with the second color (cobalt), which means "listening". Built on the theme's accent
             button, with its colors swapped for cobalt (resting, hover, pressed). -->
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Style.Resources>
                <SolidColorBrush x:Key="AccentButtonBackground" Color="{DynamicResource LagoonSecondColor}" />
                <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{DynamicResource LagoonSecondHoverColor}" />
                <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{DynamicResource LagoonSecondPressedColor}" />
                <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{DynamicResource LagoonSecondColor}" />
                <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="{DynamicResource LagoonSecondHoverColor}" />
                <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{DynamicResource LagoonSecondPressedColor}" />
                <SolidColorBrush x:Key="AccentButtonForeground" Color="{DynamicResource LagoonOnSecondColor}" />
                <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{DynamicResource LagoonOnSecondColor}" />
                <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{DynamicResource LagoonOnSecondColor}" />
            </Style.Resources>
            <Setter Property="Background" Value="{DynamicResource LagoonSecondBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource LagoonOnSecondBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LagoonSecondBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- The sync button on the green title bar: white with green symbol in light mode, green in dark mode. -->
        <Style x:Key="TitleBarSyncButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Style.Resources>
                <SolidColorBrush x:Key="AccentButtonBackground" Color="{DynamicResource LagoonTitleSyncColor}" />
                <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{DynamicResource LagoonTitleSyncHoverColor}" />
                <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{DynamicResource LagoonTitleSyncPressedColor}" />
                <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{DynamicResource LagoonTitleSyncColor}" />
                <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="{DynamicResource LagoonTitleSyncHoverColor}" />
                <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{DynamicResource LagoonTitleSyncPressedColor}" />
                <SolidColorBrush x:Key="AccentButtonForeground" Color="{DynamicResource LagoonOnTitleSyncColor}" />
                <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{DynamicResource LagoonOnTitleSyncColor}" />
                <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{DynamicResource LagoonOnTitleSyncColor}" />
            </Style.Resources>
        </Style>
        <!-- The same as a small square symbol button (the Play button in the stage toolbar). -->
        <Style x:Key="PlayIconButton" TargetType="Button" BasedOn="{StaticResource PlayButton}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
    </Application.Resources>
</Application>
